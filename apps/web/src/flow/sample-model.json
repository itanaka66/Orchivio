{
  "application": {
    "default_locale": "ja-JP",
    "key": "inventory",
    "locales": [
      "ja-JP",
      "en-US"
    ],
    "name": "Inventory Manager",
    "version": "0.1.0"
  },
  "lint_suppressions": [],
  "modules": [
    {
      "element_id": "00000000-0000-4000-8000-000000000001",
      "entities": [
        {
          "display_name": "Product",
          "element_id": "00000000-0000-4000-8000-000000000003",
          "fields": [
            {
              "element_id": "00000000-0000-4000-8000-000000000004",
              "generated": true,
              "name": "id",
              "primary_key": true,
              "required": false,
              "type": "uuid",
              "unique": false
            },
            {
              "element_id": "00000000-0000-4000-8000-000000000005",
              "generated": false,
              "max_length": 200,
              "name": "name",
              "primary_key": false,
              "required": true,
              "type": "string",
              "unique": false
            },
            {
              "element_id": "00000000-0000-4000-8000-000000000006",
              "generated": false,
              "name": "sku",
              "primary_key": false,
              "required": true,
              "type": "string",
              "unique": true
            },
            {
              "element_id": "00000000-0000-4000-8000-000000000007",
              "generated": false,
              "minimum": 0,
              "name": "quantity",
              "primary_key": false,
              "required": true,
              "type": "integer",
              "unique": false
            },
            {
              "element_id": "00000000-0000-4000-8000-000000000008",
              "generated": false,
              "minimum": 0,
              "name": "reorder_level",
              "primary_key": false,
              "required": true,
              "type": "integer",
              "unique": false
            },
            {
              "computed": {
                "expr": "quantity == 0 ? StockStatus.out_of_stock : (quantity <= reorder_level ? StockStatus.low : StockStatus.in_stock)\n",
                "mode": "virtual"
              },
              "element_id": "00000000-0000-4000-8000-000000000009",
              "generated": false,
              "name": "status",
              "primary_key": false,
              "required": false,
              "type": "enum:StockStatus",
              "unique": false
            },
            {
              "default_expr": "$currentUser",
              "element_id": "00000000-0000-4000-8000-000000000010",
              "generated": false,
              "name": "owner",
              "primary_key": false,
              "required": true,
              "type": "ref:system.User",
              "unique": false
            },
            {
              "element_id": "00000000-0000-4000-8000-000000000011",
              "generated": true,
              "name": "created_at",
              "primary_key": false,
              "required": false,
              "type": "datetime",
              "unique": false
            }
          ],
          "hooks": {},
          "indexes": [
            {
              "fields": [
                "owner"
              ],
              "unique": false
            }
          ],
          "name": "Product",
          "transient": false
        }
      ],
      "enumerations": [
        {
          "element_id": "00000000-0000-4000-8000-000000000002",
          "name": "StockStatus",
          "values": [
            "in_stock",
            "low",
            "out_of_stock"
          ]
        }
      ],
      "flows": [
        {
          "description": "Mark products that fell below their reorder level and raise an error if none exist.",
          "edges": [
            {
              "handle": "out",
              "id": "e1",
              "source": "start",
              "target": "find"
            },
            {
              "handle": "out",
              "id": "e2",
              "source": "find",
              "target": "any"
            },
            {
              "handle": "true",
              "id": "e3",
              "source": "any",
              "target": "each"
            },
            {
              "handle": "false",
              "id": "e4",
              "source": "any",
              "target": "none"
            },
            {
              "handle": "body",
              "id": "e5",
              "source": "each",
              "target": "bump"
            },
            {
              "handle": "done",
              "id": "e6",
              "source": "each",
              "target": "done"
            }
          ],
          "element_id": "00000000-0000-4000-8000-000000000014",
          "key": "ReorderLowStock",
          "kind": "server",
          "params": [
            {
              "name": "min_gap",
              "type": "integer"
            }
          ],
          "steps": [
            {
              "config": {},
              "id": "start",
              "position": {
                "x": 0.0,
                "y": 0.0
              },
              "type": "start"
            },
            {
              "config": {
                "entity": "Product",
                "into": "low",
                "limit": 100,
                "many": true,
                "where": "quantity <= reorder_level - min_gap"
              },
              "id": "find",
              "label": "Find products",
              "position": {
                "x": 0.0,
                "y": 120.0
              },
              "type": "retrieve"
            },
            {
              "config": {
                "expr": "size(low) > 0"
              },
              "id": "any",
              "label": "Any found?",
              "position": {
                "x": 0.0,
                "y": 240.0
              },
              "type": "decision"
            },
            {
              "config": {
                "item": "product",
                "max_iterations": 100,
                "over": "low"
              },
              "id": "each",
              "label": "For each product",
              "position": {
                "x": -140.0,
                "y": 380.0
              },
              "type": "loop"
            },
            {
              "config": {
                "target": "product",
                "values": {
                  "reorder_level": "product.reorder_level + 5"
                }
              },
              "id": "bump",
              "position": {
                "x": -280.0,
                "y": 520.0
              },
              "type": "change"
            },
            {
              "config": {},
              "id": "done",
              "label": "Done",
              "position": {
                "x": -140.0,
                "y": 660.0
              },
              "type": "end"
            },
            {
              "config": {
                "message": "No product is below its reorder level"
              },
              "id": "none",
              "position": {
                "x": 160.0,
                "y": 380.0
              },
              "type": "raise_error"
            }
          ]
        }
      ],
      "key": "core",
      "pages": [
        {
          "actions": [
            {
              "key": "edit",
              "visible_expr": "$currentUser.hasRole('editor')"
            },
            "view",
            "create"
          ],
          "columns": [
            "name",
            "sku",
            "quantity",
            "status"
          ],
          "element_id": "00000000-0000-4000-8000-000000000012",
          "entity": "Product",
          "key": "product-list",
          "layout": "main",
          "path": "/products",
          "type": "list"
        },
        {
          "actions": [],
          "columns": [],
          "element_id": "00000000-0000-4000-8000-000000000013",
          "entity": "Product",
          "key": "product-create",
          "mode": "create",
          "path": "/products/new",
          "type": "form"
        }
      ]
    }
  ],
  "schema_version": "1.1",
  "security": {
    "access": [
      {
        "element_id": "00000000-0000-4000-8000-000000000015",
        "entity": "core.Product",
        "operations": [
          "read"
        ],
        "role": "viewer"
      },
      {
        "element_id": "00000000-0000-4000-8000-000000000016",
        "entity": "core.Product",
        "operations": [
          "read",
          "create",
          "update"
        ],
        "role": "editor",
        "row_constraint": "record.owner == $currentUser"
      },
      {
        "element_id": "00000000-0000-4000-8000-000000000017",
        "entity": "core.Product",
        "operations": [
          "read",
          "create",
          "update",
          "delete"
        ],
        "role": "admin"
      }
    ],
    "anonymous": false,
    "pages": {
      "product-create": [
        "editor",
        "admin"
      ],
      "product-list": [
        "viewer",
        "editor",
        "admin"
      ]
    },
    "roles": [
      "viewer",
      "editor",
      "admin"
    ]
  }
}
