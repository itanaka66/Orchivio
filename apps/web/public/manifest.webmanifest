{
  "name": "Orchivio Studio",
  "short_name": "Orchivio",
  "description": "Design, review and operate applications with Orchivio.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "lang": "en",
  "theme_color": "#2f5fd0",
  "background_color": "#f6f7f9",
  "categories": ["productivity", "developer tools"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New application",
      "short_name": "New app",
      "description": "Create a new application",
      "url": "/?action=new-application",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Review proposals",
      "short_name": "Proposals",
      "description": "Open pending proposals for review",
      "url": "/?action=proposals",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open preview",
      "short_name": "Preview",
      "description": "Launch the app preview board",
      "url": "/?action=preview",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Orchivio Studio — model designer"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Orchivio Studio — mobile view"
    }
  ]
}
