# Copy to .env (never commit .env). Generate secrets, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# dev | prod. prod forces Secure cookies, so serve it over HTTPS.
ORCHIVIO_ENV=dev
# Set to false to stop new sign-ups once your accounts exist.
ORCHIVIO_ALLOW_REGISTRATION=true
