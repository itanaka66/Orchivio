# Copy to .env (never commit .env). Generate secrets, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# dev | prod. prod forces Secure cookies (serve over HTTPS) and a separate preview database.
ORCHIVIO_ENV=dev
# Set to false to stop new sign-ups once your accounts exist.
ORCHIVIO_ALLOW_REGISTRATION=true

# Prometheus scraping: /metrics is disabled until this is set (then needs `Authorization: Bearer <token>`).
ORCHIVIO_METRICS_TOKEN=

# AI Builder: none (default) or anna. anna routes completions through the Anna AI OS sampling relay.
# Set ORCHIVIO_ANNA_SAMPLING_URL to the URL announced by the Orchivio executa plugin at startup
# (printed to stderr as: ORCHIVIO_ANNA_SAMPLING_URL=http://127.0.0.1:<port>).
ORCHIVIO_LLM_PROVIDER=none
ORCHIVIO_ANNA_SAMPLING_URL=
ORCHIVIO_LLM_MODEL=
